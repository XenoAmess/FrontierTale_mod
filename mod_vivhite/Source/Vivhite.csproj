<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>1.0.0</Version>
    <DebugType>none</DebugType>
    <GameAssemblies>$(GameDir)/FrontierTale_Data/Managed</GameAssemblies>
    <PackageDirectory>$(MSBuildThisFileDirectory)../vivhite</PackageDirectory>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Lib.Harmony" Version="2.4.3" GeneratePathProperty="true" ExcludeAssets="all" PrivateAssets="all" />
    <Reference Include="0Harmony" HintPath="$(PkgLib_Harmony)/lib/net472/0Harmony.dll" Private="false" />
    <EmbeddedResource Include="$(PkgLib_Harmony)/lib/net472/0Harmony.dll" LogicalName="Vivhite.0Harmony.dll" Condition="'$(PkgLib_Harmony)' != ''" />
    <EmbeddedResource Include="$(PkgLib_Harmony)/LICENSE" LogicalName="Vivhite.Harmony-LICENSE.txt" Condition="'$(PkgLib_Harmony)' != ''" />
    <Reference Include="$(GameAssemblies)/FrontierTale.ModSDK.dll;$(GameAssemblies)/Assembly-CSharp.dll;$(GameAssemblies)/Newtonsoft.Json.dll;$(GameAssemblies)/UniTask.dll;$(GameAssemblies)/UnityEngine.CoreModule.dll;$(GameAssemblies)/UnityEngine.UIModule.dll;$(GameAssemblies)/UnityEngine.ImageConversionModule.dll;$(GameAssemblies)/UnityEngine.UI.dll;$(GameAssemblies)/spine-csharp.dll;$(GameAssemblies)/spine-unity.dll">
      <Private>false</Private>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGame" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameAssemblies)/FrontierTale.ModSDK.dll')" Text="Set -p:GameDir to the Frontier Tale installation directory." />
  </Target>
  <Target Name="CopyMod" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageDirectory)" />
  </Target>
</Project>
