<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <Version>1.0.3</Version>
    <DebugType>none</DebugType>
    <GameAssemblies>$(GameDir)/FrontierTale_Data/Managed</GameAssemblies>
    <PackageDirectory>$(MSBuildThisFileDirectory)../quick-chest-loot</PackageDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="$(GameAssemblies)/FrontierTale.ModSDK.dll;$(GameAssemblies)/Assembly-CSharp.dll;$(GameAssemblies)/UnityEngine.CoreModule.dll;$(GameAssemblies)/UnityEngine.UIModule.dll">
      <Private>false</Private>
      <ExternallyResolved>true</ExternallyResolved>
    </Reference>
  </ItemGroup>
  <Target Name="CheckGame" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(GameAssemblies)/FrontierTale.ModSDK.dll')" Text="Set -p:GameDir to the Frontier Tale installation directory." />
  </Target>
  <Target Name="CopyMod" AfterTargets="Build">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PackageDirectory)" />
  </Target>
</Project>
